#!/usr/bin/env bash
# Pre-commit hook: format staged Rust and Markdown, and nothing heavier — keep
# it under ~2 s; clippy, the tests and the rest of the gate run in CI.
#
# Two independent sections, Rust (rustfmt) and Markdown (deno fmt). A missing
# tool in one section must NOT skip the other, so each section guards itself
# rather than exiting the whole hook.

# --- Chain the developer's global pre-commit, if they have one -------------
# `mise run setup` points core.hooksPath at this directory, and that setting is
# single-valued: from then on a global hook the developer installed no longer
# runs in this repo, without anything saying so. A guard they rely on
# everywhere else would be off in exactly one place. Running it first, and
# adopting its refusal, keeps that from happening. A developer with no global
# hook notices nothing.
global_hooks=$(git config --global --type=path --get core.hooksPath)
if [ -n "${global_hooks:-}" ] && [ -x "$global_hooks/pre-commit" ] &&
    ! [ "$global_hooks/pre-commit" -ef "$0" ]; then
    "$global_hooks/pre-commit" || exit 1
fi

# staged_regular_files <pathspec>...: print, NUL-separated, the staged added,
# copied, modified and renamed paths whose index entry is a regular file. A
# symlink (120000) or a submodule (160000) is never formatted: its blob is not
# file content, and writing a result back would go through the link.
staged_regular_files() {
    local meta path
    local -a fields
    while IFS= read -r -d '' meta; do
        read -r -a fields <<< "$meta"
        IFS= read -r -d '' path
        case ${fields[4]} in R* | C*) IFS= read -r -d '' path ;; esac
        case ${fields[1]} in 100644 | 100755) printf '%s\0' "$path" ;; esac
    done < <(git diff --cached -z --raw --diff-filter=ACMR -- "$@")
}

# format_staged <formatter> <file>...: run <formatter>, a filter from stdin to
# stdout, over what is staged of each file, and stop the commit if it fails.
#
# The formatter reads the index, never the worktree: a file staged in part with
# `git add -p` is formatted as it will be committed, and rustfmt, which follows
# `mod` declarations when it is given a path, touches no other file.
#
# A changed result is written back and re-staged only for a file with no
# unstaged changes. `git add` stages the whole worktree file, never the hunks
# that were chosen, so re-adding a file with unstaged work would commit the part
# the author deliberately kept out of the index, and nothing anywhere would say
# so. Such a file is named instead and left alone, index and worktree: what is
# committed is exactly what was staged — possibly unformatted, which CI will say
# out loud. So is a worktree path that is not a regular file reached without a
# symlink, since writing to it would land somewhere else.
#
# The blob is read at stage 0 explicitly: `:<path>` would read `:0:y.rs` as
# stage 0 of y.rs.
format_staged() {
    local formatter="$1" file listed staged formatted top
    local -a dirty
    shift
    top=$(pwd -P)
    mapfile -d '' -t dirty < <(git --literal-pathspecs diff -z --name-only -- "$@")
    staged=$(mktemp)
    formatted=$(mktemp)
    for file in "$@"; do
        if ! git cat-file blob ":0:$file" > "$staged"; then
            echo "pre-commit: cannot read the staged $file" >&2
            rm -f "$staged" "$formatted"
            return 1
        fi
        if ! "$formatter" < "$staged" > "$formatted"; then
            echo "pre-commit: $file does not format — fix what the formatter reported above" >&2
            rm -f "$staged" "$formatted"
            return 1
        fi
        cmp -s "$staged" "$formatted" && continue
        for listed in "${dirty[@]}"; do
            if [ "$listed" = "$file" ]; then
                echo "pre-commit: $file has unstaged changes — leaving it exactly as you staged it, unformatted"
                continue 2
            fi
        done
        if [ -L "$file" ] || ! [ -f "$file" ] || [ "$(realpath -- "$file")" != "$top/$file" ]; then
            echo "pre-commit: $file is not a regular file in the worktree — leaving it exactly as you staged it, unformatted"
            continue
        fi
        if ! cat "$formatted" > "$file" || ! git --literal-pathspecs add -- "$file"; then
            echo "pre-commit: cannot write back and stage the formatted $file" >&2
            rm -f "$staged" "$formatted"
            return 1
        fi
    done
    rm -f "$staged" "$formatted"
}

# --- Rust: rustfmt --------------------------------------------------------
# rustfmt reading stdin knows no edition, so it is read from Cargo.toml (a
# single crate).
RUSTFMT="$(mise which rustfmt 2>/dev/null)"
if [ -z "$RUSTFMT" ]; then
    RUSTFMT="$(command -v rustfmt 2>/dev/null)"
fi
if [ -z "$RUSTFMT" ]; then
    echo "pre-commit: rustfmt not found (run 'mise run setup'), skipping Rust format"
else
    mapfile -d '' -t STAGED_RS < <(staged_regular_files '*.rs')
    if [ "${#STAGED_RS[@]}" -gt 0 ]; then
        EDITION=$(sed -n 's/^edition = "\(.*\)"$/\1/p' "$(git rev-parse --show-toplevel)/Cargo.toml")
        if [ -z "$EDITION" ]; then
            echo "pre-commit: no edition = \"...\" line in Cargo.toml, so rustfmt cannot be told the edition" >&2
            exit 1
        fi
        format_rust() { "$RUSTFMT" --edition "$EDITION" --emit stdout; }
        format_staged format_rust "${STAGED_RS[@]}" || exit 1
    fi
fi

# --- Markdown: deno fmt ---------------------------------------------------
DENO="$(mise which deno 2>/dev/null)"
if [ -z "$DENO" ]; then
    DENO="$(command -v deno 2>/dev/null)"
fi
if [ -z "$DENO" ]; then
    echo "pre-commit: deno not found (run 'mise run setup'), skipping Markdown format"
else
    # Minus the paths deno.json excludes: formatting from stdin skips its
    # include and exclude lists.
    mapfile -d '' -t STAGED_MD < <(staged_regular_files '*.md' \
        | grep -z -vE '^(CHANGELOG\.md$|target/|build/|\.claude/worktrees/|\.worktrees/)')
    if [ "${#STAGED_MD[@]}" -gt 0 ]; then
        format_markdown() { "$DENO" fmt --ext md -; }
        format_staged format_markdown "${STAGED_MD[@]}" || exit 1
    fi
fi
