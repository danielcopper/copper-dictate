#!/usr/bin/env bash
# Pre-commit hook: format staged source files. Fast only — clippy, the tests
# and the rest of the gate run in CI on PR push, not in the commit hook. Keep
# this hook fast (<2s) so commits don't become friction; CI + branch protection
# is where correctness is enforced.
#
# Two independent sections — Rust (rustfmt) and Markdown (deno fmt). A no-op
# or missing tool in one section must NOT skip the other, so each section
# guards itself rather than exiting the whole hook.

# --- Chain the developer's global pre-commit, if they have one -------------
# `mise run setup` points core.hooksPath at this directory, and that setting is
# single-valued: from then on a global hook the developer installed no longer
# runs in this repo, without anything saying so. A guard they rely on
# everywhere else would be off in exactly one place. Running it first, and
# adopting its refusal, keeps that from happening. A developer with no global
# hook notices nothing.
global_hooks=$(git config --global --type=path --get core.hooksPath)
if [ -n "${global_hooks:-}" ] && [ -x "$global_hooks/pre-commit" ] &&
    ! [ "$global_hooks/pre-commit" -ef "$0" ]; then
    "$global_hooks/pre-commit" || exit 1
fi

# Re-stage the files a formatter may have rewritten — but only those that had
# no unstaged changes when this hook started.
#
# `git add` stages the whole worktree file, never the hunks that were chosen,
# so re-adding a file with unstaged work commits the part the author
# deliberately kept out of the index with `git add -p`, and nothing anywhere
# says so. Such a file is named instead and left alone: the formatting reaches
# the worktree and the next commit carries it, so what is committed now is
# exactly what was staged — possibly unformatted, which CI will say out loud.
# The other direction is silent, which is why it is the one being refused.
#
# The dirty list is the caller's to take, and it must be taken BEFORE the
# formatter runs: afterwards every file the formatter rewrote looks unstaged
# and this would refuse all of them.
restage_formatted() {
    local dirty="$1" file
    shift
    for file in "$@"; do
        [ -f "$file" ] || continue
        if [[ $'\n'"$dirty"$'\n' == *$'\n'"$file"$'\n'* ]]; then
            echo "pre-commit: $file has unstaged changes — leaving the index exactly as you staged it"
            continue
        fi
        git add "$file"
    done
}

# --- Rust: format staged files with rustfmt --------------------------------
# rustfmt on the staged files rather than `cargo fmt`, which formats the whole
# crate and would rewrite files this commit does not touch. rustfmt alone does
# not know the edition, so it is read from Cargo.toml (a single crate).
RUSTFMT="$(mise which rustfmt 2>/dev/null)"
if [ -z "$RUSTFMT" ]; then
    RUSTFMT="$(command -v rustfmt 2>/dev/null)"
fi
if [ -z "$RUSTFMT" ]; then
    echo "pre-commit: rustfmt not found (run 'mise run setup'), skipping Rust format"
else
    mapfile -t STAGED_RS < <(git diff --cached --name-only --diff-filter=ACM -- '*.rs')
    if [ "${#STAGED_RS[@]}" -gt 0 ]; then
        # Before formatting, or every formatted file reads as dirty.
        DIRTY_RS=$(git diff --name-only -- "${STAGED_RS[@]}")
        EDITION=$(sed -n 's/^edition = "\(.*\)"$/\1/p' "$(git rev-parse --show-toplevel)/Cargo.toml")

        "$RUSTFMT" --edition "$EDITION" "${STAGED_RS[@]}"

        restage_formatted "$DIRTY_RS" "${STAGED_RS[@]}"
    fi
fi

# --- Markdown: format staged Markdown with deno fmt -----------------------
# Find deno — prefer the mise-managed binary, fall back to PATH
DENO="$(mise which deno 2>/dev/null)"
if [ -z "$DENO" ]; then
    DENO="$(command -v deno 2>/dev/null)"
fi
if [ -z "$DENO" ]; then
    echo "pre-commit: deno not found (run 'mise run setup'), skipping Markdown format"
else
    # Get staged Markdown files, minus the paths deno.json excludes. Skip if none.
    mapfile -t STAGED_MD < <(git diff --cached --name-only --diff-filter=ACM -- '*.md' \
        | grep -vE '^(CHANGELOG\.md$|target/|build/|\.claude/worktrees/|\.worktrees/)')
    if [ "${#STAGED_MD[@]}" -gt 0 ]; then
        # Before formatting, or every formatted file reads as dirty.
        DIRTY_MD=$(git diff --name-only -- "${STAGED_MD[@]}")

        # Format staged files (deno.json: proseWrap=always, lineWidth=120), then re-stage
        "$DENO" fmt "${STAGED_MD[@]}"

        restage_formatted "$DIRTY_MD" "${STAGED_MD[@]}"
    fi
fi
